{
  "name": "@wb/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Zod schemas, types, role matrix, WS protocol constants and the Yjs room provider",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "jose": "^5.9.3",
    "lib0": "^0.2.97",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^20.16.5",
    "eslint": "^9.39.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
