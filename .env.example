# ---------------------------------------------------------------------------
# apps/web  (copy to apps/web/.env.local)
# ---------------------------------------------------------------------------

# Public — safe to ship to the browser. Nothing else may be NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_WS_URL=ws://localhost:4001
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only — read by Next.js route handlers via `server-only` modules.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Legacy HS256 secret from Supabase → Settings → API → JWT Secret.
# Leave blank to verify with the project's JWKS (asymmetric signing keys).
SUPABASE_JWT_SECRET=

UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=whiteboard-assets

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

RESEND_API_KEY=
RESEND_FROM="Whiteboard <invites@your-verified-domain.com>"

# ---------------------------------------------------------------------------
# apps/ws-server  (copy to apps/ws-server/.env)
# ---------------------------------------------------------------------------

PORT=4001
HOST=0.0.0.0
LOG_LEVEL=info

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Upstash TCP endpoint (Pub/Sub needs a persistent connection; REST cannot SUBSCRIBE).
REDIS_URL=rediss://default:YOUR-TOKEN@YOUR-DB.upstash.io:6379

# Comma-separated explicit allowlist. Connections with any other Origin are rejected.
ALLOWED_ORIGINS=http://localhost:3000
